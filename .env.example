# BucketIO configuration. Copy to .env and fill in what you need.
# Everything has a safe default: TREG_MODE=mock + LAYA_MODE=off runs fully offline.

# --- storage ---
DB_PATH=./bucketio.db

# --- Treg (the contact data source) ---
# mock | http | cli   (mock = deterministic fixture, no network, no cost)
TREG_MODE=mock
TREG_BASE_URL=https://treg.to
# Token: prefer a per-org token. Leave blank to fall back to ~/.treg/config.json
TREG_TOKEN=
# Only needed when TREG_TOKEN is an identity token (not a per-org token)
TREG_ORG=
# $ per successful call, used for the cost report (routed floors, live 2026-09-24)
TREG_FIND_COST=0.004834
TREG_VERIFY_COST=0.0015

# --- Laya (the local scorer / tie-breaker sidecar) ---
# off | shadow | active
LAYA_MODE=off
# http | inprocess
LAYA_TRANSPORT=http
LAYA_URL=http://127.0.0.1:8001
LAYA_API_KEY=change-me
LAYA_TIMEOUT_S=4.0
LAYA_WEIGHT=0.3

# --- routing thresholds ---
CACHE_TTL_DAYS=90
VERIFY_MIN_POSTERIOR=0.60
VERIFY_MIN_HITS=2
VERIFY_MAX_TRIES=2
GENERATE_VERIFY_TOP=1

# --- misc ---
USE_TF=0

